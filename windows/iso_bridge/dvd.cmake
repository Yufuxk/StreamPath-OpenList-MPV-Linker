include(FetchContent)
set(DVD_VENDOR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/dvd")
FetchContent_Declare(dvdread_src
  URL "${DVD_VENDOR}/libdvdread-7.1.1.tar.xz"
  URL_HASH SHA256=a0d47876548bec806774bbf8dbf20bb19ba139464383156b32eb8e59915b90a9)
FetchContent_Declare(dvdnav_src
  URL "${DVD_VENDOR}/libdvdnav-7.0.0.tar.xz"
  URL_HASH SHA256=a2a18f5ad36d133c74bf9106b6445806fa253b09141a46392550394b647b221e)
FetchContent_GetProperties(dvdread_src)
if(NOT dvdread_src_POPULATED)
  FetchContent_Populate(dvdread_src)
endif()
FetchContent_GetProperties(dvdnav_src)
if(NOT dvdnav_src_POPULATED)
  FetchContent_Populate(dvdnav_src)
endif()
set(DVDREAD_VERSION_MAJOR 7)
set(DVDREAD_VERSION_MINOR 1)
set(DVDREAD_VERSION_MICRO 1)
set(DVDNAV_MAJOR 7)
set(DVDNAV_MINOR 0)
set(DVDNAV_SUB 0)
file(MAKE_DIRECTORY "${dvdread_src_BINARY_DIR}/dvdread" "${dvdnav_src_BINARY_DIR}/dvdnav")
# UCRT 已提供标准 snprintf；旧兼容头的宏会覆盖其声明。
foreach(component IN ITEMS dvdread dvdnav)
  file(READ "${${component}_src_SOURCE_DIR}/msvc/include/unistd.h" compat_header)
  string(REPLACE "#define snprintf _snprintf" "" compat_header "${compat_header}")
  string(REPLACE "#define vsnprintf _vsnprintf" "" compat_header "${compat_header}")
  file(WRITE "${${component}_src_BINARY_DIR}/unistd.h" "${compat_header}")
endforeach()
# 修正上游 MSVC 分支的旧式可变参数宏，源码归档保持原样。
file(READ "${dvdnav_src_SOURCE_DIR}/src/dvdnav_internal.h" nav_internal)
string(REPLACE "#define printerrf(str)" "#define printerrf(...)" nav_internal "${nav_internal}")
string(REPLACE "MAX_ERR_LEN, str);" "MAX_ERR_LEN, __VA_ARGS__);" nav_internal "${nav_internal}")
file(WRITE "${dvdnav_src_SOURCE_DIR}/src/dvdnav_internal.h" "${nav_internal}")
file(READ "${dvdnav_src_SOURCE_DIR}/src/read_cache.c" nav_cache)
string(REPLACE "#  define dprintf(fmt, str)" "#  define dprintf(...)" nav_cache "${nav_cache}")
file(WRITE "${dvdnav_src_SOURCE_DIR}/src/read_cache.c" "${nav_cache}")
file(REMOVE "${dvdnav_src_SOURCE_DIR}/msvc/include/inttypes.h")
# Windows off_t 为 32 位，流回调的 ISO 字节地址必须保持 64 位。
file(READ "${dvdread_src_SOURCE_DIR}/src/dvd_input.c" dvd_input)
string(REPLACE "(off_t)blocks * (off_t)DVD_VIDEO_LB_LEN"
  "(uint64_t)blocks * (uint64_t)DVD_VIDEO_LB_LEN" dvd_input "${dvd_input}")
# 固定使用内置读取器，不探测或加载用户环境中的 CSS 解密库。
string(FIND "${dvd_input}" "int dvdinput_setup(" dvd_setup_start)
string(FIND "${dvd_input}" "/**\n * Setup read functions with the builtin" dvd_setup_end)
if(dvd_setup_start LESS 0 OR dvd_setup_end LESS dvd_setup_start)
  message(FATAL_ERROR "The pinned libdvdread input setup could not be located")
endif()
string(SUBSTRING "${dvd_input}" 0 ${dvd_setup_start} dvd_input_prefix)
string(SUBSTRING "${dvd_input}" ${dvd_setup_end} -1 dvd_input_suffix)
set(dvd_input "${dvd_input_prefix}int dvdinput_setup(void *priv, dvd_logger_cb *logcb, dvd_type_t dvda_flag)\n{\n  (void)dvda_flag;\n  dvdinput_setup_builtin(priv, logcb);\n  return 0;\n}\n\n${dvd_input_suffix}")
file(WRITE "${dvdread_src_SOURCE_DIR}/src/dvd_input.c" "${dvd_input}")
configure_file("${dvdread_src_SOURCE_DIR}/src/dvdread/version.h.in" "${dvdread_src_BINARY_DIR}/dvdread/version.h" @ONLY)
configure_file("${dvdnav_src_SOURCE_DIR}/src/dvdnav/version.h.in" "${dvdnav_src_BINARY_DIR}/dvdnav/version.h" @ONLY)
file(WRITE "${dvdread_src_BINARY_DIR}/config.h" "#define PACKAGE_VERSION \"7.1.1\"\n#define UNUSED\n#define HAVE_LIMITS_H 1\n#define HAVE_DIRENT_H 1\n#define HAVE_STRERROR_S 1\n#define HAVE_STATIC_ASSERT 1\n")
file(WRITE "${dvdnav_src_BINARY_DIR}/config.h" "#define VERSION \"7.0.0\"\n#define HAVE_STDINT_H 1\n#define HAVE_INTTYPES_H 1\n#define HAVE_MEMORY_H 1\n#define HAVE_STDLIB_H 1\n#define HAVE_STRING_H 1\n#define HAVE_SYS_STAT_H 1\n#define HAVE_SYS_TYPES_H 1\n")
set(DVDREAD_FILES bitreader dvd_input dvd_reader dvd_udf ifo_print ifo_read logger md5 nav_print nav_read file/file_win32)
set(DVDREAD_SOURCES)
foreach(item IN LISTS DVDREAD_FILES)
  list(APPEND DVDREAD_SOURCES "${dvdread_src_SOURCE_DIR}/src/${item}.c")
endforeach()
add_library(streampath_dvdread STATIC ${DVDREAD_SOURCES})
target_include_directories(streampath_dvdread PUBLIC "${dvdread_src_SOURCE_DIR}/src" "${dvdread_src_BINARY_DIR}"
  PRIVATE "${dvdread_src_SOURCE_DIR}/msvc/include" "${dvdread_src_SOURCE_DIR}/msvc/contrib/dirent")
target_compile_definitions(streampath_dvdread PRIVATE _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_WARNINGS)
target_compile_features(streampath_dvdread PRIVATE c_std_11)
set(DVDNAV_FILES dvdnav highlight logger navigation read_cache searching settings vm/decoder vm/getset vm/play vm/vm vm/vmcmd vm/vmget)
set(DVDNAV_SOURCES)
foreach(item IN LISTS DVDNAV_FILES)
  list(APPEND DVDNAV_SOURCES "${dvdnav_src_SOURCE_DIR}/src/${item}.c")
endforeach()
add_library(streampath_dvdnav STATIC ${DVDNAV_SOURCES})
target_include_directories(streampath_dvdnav PUBLIC "${dvdnav_src_SOURCE_DIR}/src" "${dvdnav_src_BINARY_DIR}"
  PRIVATE "${dvdnav_src_SOURCE_DIR}/src/vm" "${dvdnav_src_SOURCE_DIR}/msvc/include")
target_compile_definitions(streampath_dvdnav PRIVATE HAVE_CONFIG_H _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_WARNINGS)
target_compile_features(streampath_dvdnav PRIVATE c_std_11)
target_compile_options(streampath_dvdnav PRIVATE /FIwinsock2.h /FIinttypes.h /Zc:preprocessor)
target_link_libraries(streampath_dvdnav PUBLIC streampath_dvdread)
install(DIRECTORY "${DVD_VENDOR}/" DESTINATION "${CMAKE_INSTALL_PREFIX}/licenses/dvd" COMPONENT Runtime)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/dvd.cmake" DESTINATION "${CMAKE_INSTALL_PREFIX}/licenses/dvd" COMPONENT Runtime)
